{
  "info": {
    "_postman_id": "2f0f8d38-67b8-4b98-8d4c-2d1f58db4a8a",
    "name": "Bookstore Microservices OTP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Email OTP registration and password login for bookstore-microservices."
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Start Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.registrationId) pm.environment.set('registrationId', body.registrationId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{fullName}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrlAuth}}/api/auth/register/start",
              "host": [
                "{{baseUrlAuth}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "start"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Send Registration Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationId\": \"{{registrationId}}\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrlAuth}}/api/auth/register/email/send-otp",
              "host": [
                "{{baseUrlAuth}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "email",
                "send-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Complete Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.environment.set('token', body.token);",
                  "  if (body.loginId) pm.environment.set('identifier', body.loginId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationId\": \"{{registrationId}}\",\n  \"email\": \"{{email}}\",\n  \"emailOtpCode\": \"{{emailOtpCode}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrlAuth}}/api/auth/register/complete",
              "host": [
                "{{baseUrlAuth}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "complete"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login (Email or Mobile + Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrlAuth}}/api/auth/login",
              "host": [
                "{{baseUrlAuth}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrlCatalog}}/api/books",
              "host": [
                "{{baseUrlCatalog}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Orders",
      "item": [
        {
          "name": "Get My Orders (Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrlOrder}}/api/orders/my",
              "host": [
                "{{baseUrlOrder}}"
              ],
              "path": [
                "api",
                "orders",
                "my"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
