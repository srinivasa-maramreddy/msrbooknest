# Local Razorpay test-mode configuration. Keep real values in the ignored .env file.
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_ALLOW_LIVE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Use a long random value for any shared demo deployment.
APP_JWT_SECRET=replace-with-a-long-random-local-secret
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
APP_WEB_ORIGINS=https://srinivasa-maramreddy.github.io
