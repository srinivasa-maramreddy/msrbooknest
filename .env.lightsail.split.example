# Copy this file to .env.lightsail on each Mumbai instance.
# Replace every placeholder locally; never commit the filled .env.lightsail file.
API_DOMAIN=api.replace-with-a-domain-you-control.example
NODE1_PRIVATE_IP=replace-with-node1-private-ip
NODE2_PRIVATE_IP=replace-with-node2-private-ip
NODE3_PRIVATE_IP=replace-with-node3-private-ip

# Get these from the Lightsail database details after it becomes Available.
MYSQL_HOST=replace-with-lightsail-mysql-endpoint
MYSQL_PORT=3306
MYSQL_USERNAME=replace-with-lightsail-master-username
MYSQL_PASSWORD=replace-with-lightsail-managed-password
MYSQL_SSL_MODE=REQUIRED

# Use the same long random JWT key on all nodes.
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_WEB_ORIGINS=https://srinivasa-maramreddy.github.io

# Leave email OTP off unless all Gmail OAuth values are configured.
APP_EMAIL_OTP_ENABLED=false
GMAIL_SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
