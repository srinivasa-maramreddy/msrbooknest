map $http_origin $cors_allow_origin {
    default "";
    "~^https://srinivasa-maramreddy\.github\.io$" $http_origin;
}

server {
    listen 8080;
    server_name _;
    client_max_body_size 4m;

    add_header Access-Control-Allow-Origin $cors_allow_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Idempotency-Key" always;
    add_header Access-Control-Max-Age 600 always;
    add_header Vary Origin always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location = / {
        default_type application/json;
        return 200 '{"service":"msrbooknest-api-gateway","status":"ok"}';
    }

    location = /health/auth { proxy_pass http://auth-service:8081/actuator/health; }
    location = /health/catalog { proxy_pass http://catalog-service:8082/actuator/health; }
    location = /health/cart { proxy_pass http://cart-service:8084/actuator/health; }
    location = /health/orders { proxy_pass http://$NODE2_PRIVATE_IP:8083/actuator/health; }
    location = /health/payments { proxy_pass http://$NODE2_PRIVATE_IP:8085/actuator/health; }
    location = /health/buyback { proxy_pass http://$NODE2_PRIVATE_IP:8086/actuator/health; }

    location ^~ /api/auth { proxy_pass http://auth-service:8081; }
    location ^~ /api/products { proxy_pass http://catalog-service:8082; }
    location ^~ /api/books { proxy_pass http://catalog-service:8082; }
    location ^~ /api/admin { proxy_pass http://catalog-service:8082; }
    location ^~ /api/cart { proxy_pass http://cart-service:8084; }
    location ^~ /api/wishlist { proxy_pass http://cart-service:8084; }
    location ^~ /api/orders { proxy_pass http://$NODE2_PRIVATE_IP:8083; }
    location ^~ /api/payments { proxy_pass http://$NODE2_PRIVATE_IP:8085; }
    location ^~ /api/buybacks { proxy_pass http://$NODE2_PRIVATE_IP:8086; }

    location / {
        default_type application/json;
        return 404 '{"error":"Not found"}';
    }
}
