# Copy this file to .env.gmail and replace the placeholders with your local Gmail settings.
# Keep the real app password out of Git.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bookstore
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_SMTP_FROM=your-gmail@example.com
KEYCLOAK_SMTP_USERNAME=your-gmail@example.com
KEYCLOAK_SMTP_PASSWORD=replace-with-google-app-password
