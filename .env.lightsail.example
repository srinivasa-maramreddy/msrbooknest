# Copy to .env.lightsail on the Lightsail server. Never commit the copied file.
API_DOMAIN=api.example.com
APP_WEB_ORIGINS=https://srinivasa-maramreddy.github.io
APP_JWT_SECRET=replace-with-a-long-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password

# Leave OTP disabled until all Gmail OAuth values are filled in.
APP_EMAIL_OTP_ENABLED=false
GMAIL_SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
