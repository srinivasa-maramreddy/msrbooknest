# syntax=docker/dockerfile:1.7
FROM maven:3.9.9-eclipse-temurin-17 AS build

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests -pl auth-service,catalog-service,cart-service,order-service,payment-service,buyback-service -am package

FROM eclipse-temurin:17-jre
WORKDIR /app

ARG SERVICE
COPY --from=build --chown=10001:10001 "/workspace/${SERVICE}/target/${SERVICE}-1.0.0.jar" /app/app.jar

EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
