# Copy to .env.otp and add Google OAuth credentials only if enabling real email OTP delivery.
APP_JWT_SECRET=replace-with-a-long-random-local-signing-secret
APP_EMAIL_OTP_SUBJECT_PREFIX=MSRBookNest
GMAIL_SENDER_EMAIL=your-gmail-address@gmail.com
GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
