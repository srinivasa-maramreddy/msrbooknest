# Copy to .env.otp and add provider credentials only if enabling real OTP delivery.
APP_JWT_SECRET=replace-with-a-long-random-local-signing-secret
APP_EMAIL_OTP_FROM=your-email@example.com
APP_EMAIL_OTP_SUBJECT_PREFIX=msrbooknest
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-google-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
APP_SMS_MSG91_AUTH_KEY=your-msg91-auth-key
APP_SMS_MSG91_TEMPLATE_ID=your-msg91-template-id
APP_SMS_MSG91_COUNTRY_CODE=91
APP_SMS_MSG91_OTP_VARIABLE=OTP
